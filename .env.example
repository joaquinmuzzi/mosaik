# Copy to .env to change a default. Every variable is optional.

# Port of the hub. It always listens on 127.0.0.1 only.
HUB_PORT=7300

# Mosaik's own database. Default: %LOCALAPPDATA%\Mosaik\mosaik.db (Windows) or ~/.local/share/mosaik/mosaik.db
# HUB_DB_PATH=

# GameSentenceMiner database, opened read-only. Default: where GSM keeps it (%APPDATA%\GameSentenceMiner\gsm.db,
# or the folder named in ~/.config/GameSentenceMiner/data_dir.json). GSM's config.json is read from the same folder.
# GSM_DB_PATH=

ANKICONNECT_URL=http://127.0.0.1:8765

# Anki decks to read (subdecks included), and which of them are premade decks (origin refold-1k)
ANKI_DECKS=German Mining,Refold Alemán-mil
ANKI_REFOLD_DECKS=Refold Alemán-mil

# A day starts at this local hour (like Anki), in this time zone
DAY_CUTOFF_HOUR=4
TZ_NAME=America/Buenos_Aires

# How often the pull connectors run
SYNC_INTERVAL_MINUTES=5

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
